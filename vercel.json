{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/invideo", "destination": "/invideo.html" },
    { "source": "/invideo/", "destination": "/invideo.html" },
    { "source": "/convite/paola-maia", "destination": "/convite-paola-maia.html" },
    { "source": "/convite/paola-maia/", "destination": "/convite-paola-maia.html" },
    { "source": "/convite/paolamaia", "destination": "/convite-paola-maia.html" },
    { "source": "/convite/paolamaia/", "destination": "/convite-paola-maia.html" }
  ],
  "headers": [
    {
      "source": "/invideo",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" },
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/invideo/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" },
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/invideo.html",
